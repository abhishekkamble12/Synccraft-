# Environment configuration for Real-Time Collaborative Sync Engine

# Django settings
DEBUG=1
SECRET_KEY=local-dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Co-Author Configuration
# Option A: Groq (Recommended - Fast & Free tier available)
# Set your Groq API key (starts with gsk_). Endpoint and model default to:
# Base URL: https://api.groq.com/openai/v1
# Model: openai/gpt-oss-120b
GROQ_API_KEY=

# Option B: OpenAI / Other OpenAI-compatible APIs
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
